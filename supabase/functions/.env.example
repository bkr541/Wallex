# Secrets for the `plaid` edge function. Copy to supabase/functions/.env (git-ignored) and load them with:
#   supabase secrets set --env-file supabase/functions/.env
# They are stored by Supabase and are never sent to the app or the browser. The same file works for local testing with
#   supabase functions serve plaid --env-file supabase/functions/.env
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production, matching the secret above.
PLAID_ENV=sandbox
# OAuth banks (Chase and others) return here after sign-in. Both must be allowlisted in the Plaid dashboard under
# Developers -> API -> Allowed redirect URIs, and must be HTTPS.
# Web: the address of the deployed site, with a trailing slash.
PLAID_REDIRECT_URI_WEB=
# Desktop: any allowlisted HTTPS address; the desktop app catches the redirect itself, so nothing has to be hosted there.
PLAID_REDIRECT_URI_DESKTOP=
# Optional: Plaid sends transaction updates here.
PLAID_WEBHOOK_URL=
