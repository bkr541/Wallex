# Copy to .env.local (git-ignored). These two are the only values the app itself needs, and both are public by design:
# what a signed-in person can read or change is limited by row-level security in the database.
# Supabase project URL and public (anon / publishable) key, from Project Settings -> API. Never put the service_role key here.
# On Vercel, add the same two names under Project Settings -> Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The Plaid client ID, secret and environment are NOT set here. They live in Supabase as secrets for the `plaid` edge
# function: see supabase/functions/.env.example.
