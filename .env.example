# Copy to .env.local (git-ignored) to give the desktop app default Plaid credentials.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Supabase project URL and public (anon / publishable) key, from Project Settings → API. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
